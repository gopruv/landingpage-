# Frontend — copy to .env and fill in (use DEV Supabase project locally)
# See ../ENVIRONMENTS.md

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001

# Reviewer/contact form emails (comma-separated)
ADMIN_NOTIFY_EMAIL=team@orcred.com
RESEND_API_KEY=

# Platform gates (defaults: admin-only login, student apply off)
# Set to false / true when opening student & reviewer sign-in later.
NEXT_PUBLIC_ADMIN_ONLY_AUTH=true
NEXT_PUBLIC_STUDENT_APPLY_ENABLED=false
